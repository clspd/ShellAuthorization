<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="PackageVisibilityPolicy,QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />

            <category android:name="android.intent.category.BROWSABLE" />

            <data android:scheme="https" />
        </intent>

        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <application
        android:name="app.AppLogic.MainAppLogic.MyShellAuthorization.AppClass"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:directBootAware="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ShellAuthorization">
        <activity
            android:name="app.MyApp.MyShellAuthorization.MyPage.MyTemplateActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="app.MyApp.MyShellAuthorization.MyPage.LauncherActivity"
            android:configChanges="orientation|screenSize|screenLayout|uiMode|keyboardHidden"
            android:exported="false"
            android:label="@string/activity_name_launcher"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="app.MyApp.MyShellAuthorization.MyPage.MainPage"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="app.MyApp.MyShellAuthorization.MyPage.AboutActivity"
            android:exported="false"
            android:label="@string/about"
            android:theme="@style/Theme.ShellAuthorization.ActionBar"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="app.MyApp.MyShellAuthorization.LawAndCopyright.OpenSourceLicensesActivity"
            android:configChanges="orientation|screenSize|screenLayout|uiMode|keyboardHidden"
            android:exported="false"
            android:label="@string/settings_open_source_license"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="app.MyApp.MyShellAuthorization.LawAndCopyright.ProductPageOverlayActivity"
            android:exported="false"
            android:label="@string/title_product_homepage"
            android:theme="@style/Theme.Backdrop"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="app.MyApp.MyShellAuthorization.LawAndCopyright.PermissionExplanationActivity"
            android:exported="false"
            android:label="@string/settings_permission_explain"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="app.MyApp.MyShellAuthorization.LawAndCopyright.LicenseViewerActivity"
            android:exported="false"
            android:label="@string/title_activity_license"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="app.MyApp.MyShellAuthorization.MyPage.UserFirstUseLicenseShowActivity"
            android:exported="false"
            android:label="@string/license_dialog_title"
            android:theme="@style/Theme.Backdrop"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="app.MyApp.MyCommon.MySupport.MyFragmentContainer.FragmentContainerActivity"
            android:configChanges=""
            android:exported="false"
            android:label="@string/fragment_container_label"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="app.MyApp.MyCommon.MySupport.MyFragmentContainer.FragmentDialogContainerActivity"
            android:configChanges=""
            android:exported="false"
            android:label="@string/fragment_container2_label"
            android:theme="@style/Theme.Backdrop"
            android:windowSoftInputMode="adjustResize" />
        <service
            android:name=".Protected.ShellServer.ShellTransactionService"
            android:enabled="true"
            android:exported="true"
            tools:ignore="ExportedService" />
        <activity
            android:name=".Public.ShellServer.ShellRequestHandlerActivity"
            android:directBootAware="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@style/Theme.Backdrop">
            <intent-filter>
                <action android:name="top.clspd.shellauthorization.intent.action.REQUEST_BINDER" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".Public.ShellServer.ShellRequestHandlerReceiver"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="top.clspd.shellauthorization.intent.action.REQUEST_BINDER" />
            </intent-filter>
        </receiver>
    </application>

</manifest>